# Required, find them on https://manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Required for draft mode / visual editing (viewer token)
SANITY_API_READ_TOKEN=
# Optional, useful if you plan to add API functions that can write to your dataset
SANITY_API_WRITE_TOKEN=

# Canonical site origin for metadata, canonicals, sitemap, RSS and JSON-LD.
# Defaults to http://localhost:3000 in development; must be an https URL in production.
NEXT_PUBLIC_BASE_URL=

# Optional, can be used to change the Studio title in the navbar and differentiate between production and staging environments for your editors
NEXT_PUBLIC_SANITY_PROJECT_TITLE="Portfolio Blog"

# Optional, Google Analytics measurement ID
GOOGLE_ANALYTICS_ID=
