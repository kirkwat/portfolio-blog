{
  "name": "portfolio-blog",
  "private": true,
  "scripts": {
    "analyze": "next experimental-analyze --serve",
    "build": "next build --turbopack && sanity manifest extract --path public/studio/static",
    "predev": "bun run typegen",
    "dev": "next --turbopack",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "bun run format && bun run lint -- --fix",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "typegen": "sanity schema extract && sanity typegen generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@next/env": "16.2.9",
    "@next/third-parties": "^16.2.9",
    "@sanity/client": "7.22.1",
    "@sanity/icons": "3.7.4",
    "@sanity/image-url": "2.1.1",
    "@sanity/ui": "3.2.0",
    "@sanity/util": "6.0.0",
    "@sanity/vision": "6.0.0",
    "@tailwindcss/typography": "0.5.20",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-sanity": "13.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0",
    "sanity": "6.0.0",
    "sanity-plugin-asset-source-unsplash": "7.0.8",
    "server-only": "0.0.1",
    "shadcn": "^4.11.0",
    "sonner": "2.0.7",
    "styled-components": "6.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "postcss": "8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=20"
  },
  "knip": {
    "ignore": [
      "src/sanity.types.ts",
      "src/components/ui/**"
    ]
  }
}
